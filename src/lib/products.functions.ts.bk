export type Product = {
  id: number;
  product_name: string;
  price: number;
  created_at: string;
};

// const ENDPOINT = "https://nisilagro.com/products.php";
// const ENDPOINT = "/api-products";

const ENDPOINT = import.meta.env.PROD ? "https://nisilagro.com/products.php" : "/api-products";

export async function getProductsDirect(): Promise<{ products: Product[]; error: string | null }> {
  // Use the key from .env or default to the verified working token string
  const apiKey = import.meta.env.VITE_MATIFOOD_API_KEY || "matifood2026-sah";

  try {
    const res = await fetch(ENDPOINT, {
      method: "GET",
      headers: {
        "X-API-Key": apiKey,
        "Accept": "application/json",
      },
    });

    if (!res.ok) {
      return { products: [], error: `Server answered with status code: ${res.status}` };
    }

    const data = await res.json();

    // The server returns a flat array directly: [ { id: 1, ... } ]
    if (Array.isArray(data)) {
      return { products: data, error: null };
    }

    // Fallback if structure changes unexpectedly
    if (data && typeof data === "object" && "products" in data) {
      return { products: (data as any).products || [], error: null };
    }

    return { products: [], error: "Received unexpected data format from API" };
  } catch (e) {
    console.error("getProductsDirect failed:", e);
    return {
      products: [],
      error: `Connection failed: ${e?.message || "Check network configurations."}`
    };
  }
}
