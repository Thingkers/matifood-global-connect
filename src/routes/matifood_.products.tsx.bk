// /Volumes/THINGKERS/developments/matifood-global-connect/src/routes/matifood_.products.tsx
import { createFileRoute } from "@tanstack/react-router";
import { useQuery } from "@tanstack/react-query";
import { useState, useEffect, useMemo } from "react";
import { Section, Eyebrow } from "@/components/Section";
import { getProductsDirect, type Product } from "@/lib/products.functions";
import { submitOrderDirect, type OrderInput } from "@/lib/orders.functions";
import { getLocationsDirect, type Location } from "@/lib/locations.functions";

export const Route = createFileRoute("/matifood_/products")({
  head: () => ({
    meta: [
      { title: "Products Catalogue — MatiFood" },
      {
        name: "description",
        content: "Browse MatiFood's live product catalogue and place an order for premium fresh mangoes.",
      },
    ],
  }),
  component: ProductsPage,
});

interface CartItem {
  product: Product;
  quantity: number;
}

function ProductsPage() {
  const [step, setStep] = useState<"catalog" | "checkout">("catalog");
  const [cart, setCart] = useState<CartItem[]>([]);

  // Query live products database records
  const { data: productsData, isLoading: productsLoading, isError: productsError } = useQuery({
    queryKey: ["matifood-products"],
    queryFn: () => getProductsDirect(),
  });

  const products = productsData?.products ?? [];

  // Derived cart helpers
  const cartTotal = useMemo(() => {
    return cart.reduce((sum, item) => sum + Number(item.product.price) * item.quantity, 0);
  }, [cart]);

  const totalItemsCount = useMemo(() => {
    return cart.reduce((sum, item) => sum + item.quantity, 0);
  }, [cart]);

  const updateQuantity = (productId: number, delta: number) => {
    setCart((prev) => {
      const match = prev.find((item) => item.product.id === productId);
      if (!match) return prev;
      const nextQty = match.quantity + delta;
      if (nextQty <= 0) {
        return prev.filter((item) => item.product.id !== productId);
      }
      return prev.map((item) =>
        item.product.id === productId ? { ...item, quantity: nextQty } : item
      );
    });
  };

  const addToCart = (product: Product) => {
    setCart((prev) => {
      const existing = prev.find((item) => item.product.id === product.id);
      if (existing) {
        return prev.map((item) =>
          item.product.id === product.id ? { ...item, quantity: item.quantity + 1 } : item
        );
      }
      return [...prev, { product, quantity: 1 }];
    });
  };

  if (step === "checkout") {
    return (
      <CheckoutView
        cart={cart}
        cartTotal={cartTotal}
        onBack={() => setStep("catalog")}
        onClearCart={() => setCart([])}
      />
    );
  }

  return (
    <Section>
      <div className="mx-auto max-w-3xl text-center">
        <Eyebrow>Premium Selections</Eyebrow>
        <h1 className="mt-4 font-serif text-4xl font-bold sm:text-5xl tracking-tight">MatiFood Products</h1>
        <p className="mt-3 text-muted-foreground text-lg">
          Select premium farm-fresh products straight from our orchards into your basket.
        </p>
      </div>

      {/* Catalog Display Area */}
      <div className="mt-12">
        {productsLoading ? (
          <div className="py-20 text-center text-muted-foreground animate-pulse">Loading live catalogue products…</div>
        ) : productsError || productsData?.error ? (
          <div className="rounded-xl border border-destructive/20 bg-destructive/5 p-6 text-center text-destructive">
            ⚠️ {productsData?.error ?? "Failed to look up live items."}
          </div>
        ) : products.length === 0 ? (
          <div className="py-20 text-center text-muted-foreground">No products available in the collection right now.</div>
        ) : (
          <div className="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {products.map((p) => {
              const inCartItem = cart.find((item) => item.product.id === p.id);
              return (
                <div
                  key={p.id}
                  className="group relative flex flex-col justify-between overflow-hidden rounded-2xl border border-border bg-card p-5 transition-all hover:shadow-[var(--shadow-soft)] hover:border-primary/20"
                >
                  <div>
                    {/* Placeholder image representation matching natural fresh aesthetics */}
                    <div className="aspect-[4/3] w-full rounded-xl bg-secondary/40 overflow-hidden flex items-center justify-center relative group-hover:scale-105 transition-transform duration-300">
                      {p.image_url ? (
                        <img 
                          src={p.image_url} 
                          alt={p.product_name} 
                          className="w-full h-full object-cover"
                          onError={(e) => {
                            // Fallback gracefully to default emoji if image paths ever break
                            (e.target as HTMLImageElement).style.display = "none";
                          }}
                        />
                      ) : (
                        <span className="text-4xl">🥭</span>
                      )}
                    </div>
                    <h3 className="mt-4 font-serif text-xl font-bold tracking-tight">{p.product_name}</h3>
                    <div className="mt-2 text-2xl font-semibold text-primary">৳{Number(p.price).toLocaleString()}</div>
                  </div>

                  <div className="mt-6">
                    {inCartItem ? (
                      <div className="flex h-11 items-center justify-between rounded-lg border border-primary/30 bg-primary/5 px-2">
                        <button
                          onClick={() => updateQuantity(p.id, -1)}
                          className="flex h-8 w-8 items-center justify-center rounded-md text-xl font-bold hover:bg-primary/10 text-primary"
                        >
                          −
                        </button>
                        <span className="font-semibold text-sm px-2">{inCartItem.quantity} Box(es)</span>
                        <button
                          onClick={() => updateQuantity(p.id, 1)}
                          className="flex h-8 w-8 items-center justify-center rounded-md text-xl font-bold hover:bg-primary/10 text-primary"
                        >
                          +
                        </button>
                      </div>
                    ) : (
                      <button
                        onClick={() => addToCart(p)}
                        className="flex h-11 w-full items-center justify-center gap-2 rounded-lg bg-secondary font-medium text-foreground transition-all hover:bg-primary hover:text-primary-foreground"
                      >
                        Add to Basket 🛒
                      </button>
                    )}
                  </div>
                </div>
              );
            })}
          </div>
        )}
      </div>

      {/* Persistent Floating Bottom Action Bar */}
      {cart.length > 0 && (
        <div className="sticky bottom-6 left-0 right-0 z-50 mx-auto mt-12 max-w-xl px-4">
          <div className="flex items-center justify-between gap-4 rounded-2xl border border-primary/20 bg-card/95 p-4 backdrop-blur-md shadow-2xl animate-in fade-in slide-in-from-bottom-4">
            <div>
              <div className="text-sm font-medium text-muted-foreground">{totalItemsCount} boxes chosen</div>
              <div className="text-xl font-bold text-foreground">৳{cartTotal.toLocaleString()}</div>
            </div>
            <button
              onClick={() => setStep("checkout")}
              className="rounded-xl bg-primary px-6 py-3 font-semibold text-primary-foreground shadow-md transition-all hover:bg-primary-glow hover:scale-[1.02]"
            >
              Proceed to Checkout →
            </button>
          </div>
        </div>
      )}
    </Section>
  );
}

interface CheckoutViewProps {
  cart: CartItem[];
  cartTotal: number;
  onBack: () => void;
  onClearCart: () => void;
}

function CheckoutView({ cart, cartTotal, onBack, onClearCart }: CheckoutViewProps) {
  const { data: locations } = useQuery({
    queryKey: ["matifood-locations"],
    queryFn: () => getLocationsDirect(),
  });

  const [form, setForm] = useState<OrderInput>({
    customer_name: "",
    phone: "",
    email: "",
    area: "Dhaka",
    location_id: "",
    delivery_address: "",
    product: "", 
    quantity: 1,
    payment_method: "Cash On Delivery",
    payment_note: "",
  });

  const [status, setStatus] = useState<
    | { kind: "idle" }
    | { kind: "pending" }
    | { kind: "ok"; id?: number }
    | { kind: "error"; msg: string }
  >({ kind: "idle" });

  const set = <K extends keyof OrderInput>(k: K, v: OrderInput[K]) =>
    setForm((f) => ({ ...f, [k]: v }));

  // Auto-map selected location to area coordinates
  useEffect(() => {
    if (!locations || locations.length === 0) return;
    if (!form.location_id) {
      const first = locations[0];
      if (first) {
        set("location_id", first.id as OrderInput["location_id"]);
        set("area", first.area as OrderInput["area"]);
      }
      return;
    }
    const sel = locations.find((l: Location) => l.id === form.location_id);
    if (sel) {
      set("area", sel.area as OrderInput["area"]);
    }
  }, [form.location_id, locations]);

  // Handle transaction submission pipeline loops
  async function onSubmit(e: React.FormEvent) {
    e.preventDefault();
    if (cart.length === 0) return;
    setStatus({ kind: "pending" });

    try {
      // Compose order summary parameters for multi-item array compatibility constraints
      const itemSummary = cart.map((i) => `${i.product.product_name} (x${i.quantity})`).join(", ");
      const totalBoxesCount = cart.reduce((sum, item) => sum + item.quantity, 0);

      const payload: OrderInput = {
        ...form,
        product: itemSummary,
        quantity: totalBoxesCount,
      };

      const res = await submitOrderDirect(payload);

      if (res.ok) {
        setStatus({ kind: "ok", id: res.id ?? undefined });
        onClearCart();
      } else {
        setStatus({ kind: "error", msg: res.error ?? "Failed to save data records." });
      }
    } catch (err) {
      setStatus({ kind: "error", msg: "An unexpected network error happened." });
    }
  }

  return (
    <Section>
      <button
        onClick={onBack}
        className="inline-flex items-center gap-2 rounded-md border border-border bg-card px-4 py-2 text-sm font-medium hover:bg-secondary transition-colors"
      >
        ← Continue Shopping
      </button>

      {status.kind === "ok" ? (
        <div className="mx-auto mt-12 max-w-md text-center rounded-2xl border border-primary/20 bg-primary/5 p-8 shadow-[var(--shadow-soft)] animate-in zoom-in-95">
          <span className="text-5xl">🎉</span>
          <h2 className="mt-4 font-serif text-2xl font-bold">Order Received successfully!</h2>
          <p className="mt-2 text-sm text-muted-foreground">
            Thank you for shopping. We've recorded your basket parameters and will call shortly.
          </p>
          {status.id && (
            <div className="mt-4 inline-block rounded-md bg-background px-3 py-1 text-xs font-mono font-bold uppercase tracking-wider text-primary border border-primary/20">
              Reference ID: #{status.id}
            </div>
          )}
          <button
            onClick={onBack}
            className="mt-6 w-full rounded-lg bg-primary px-4 py-2.5 text-sm font-semibold text-primary-foreground hover:bg-primary-glow"
          >
            Return to Catalogue
          </button>
        </div>
      ) : (
        <div className="mt-8 grid gap-8 lg:grid-cols-12 items-start">
          {/* Left Hand: Fields Processing Elements */}
          <form onSubmit={onSubmit} className="lg:col-span-7 space-y-6 rounded-2xl border border-border bg-card p-6 shadow-[var(--shadow-soft)]">
            <h2 className="font-serif text-2xl font-bold tracking-tight border-b border-border pb-3">Delivery Checkout Details</h2>
            
            <div className="space-y-4">
              <h3 className="text-sm font-semibold text-primary uppercase tracking-wider">👤 Contact Records</h3>
              <div className="grid gap-4 sm:grid-cols-2">
                <Field label="Full Name *">
                  <input required maxLength={120} value={form.customer_name} onChange={(e) => set("customer_name", e.target.value)} className={inputCls} placeholder="John Doe" />
                </Field>
                <Field label="Phone Number *">
                  <input required maxLength={40} value={form.phone} onChange={(e) => set("phone", e.target.value)} className={inputCls} placeholder="017XXXXXXXX" />
                </Field>
              </div>
              <Field label="Email Address (Optional)">
                <input type="email" maxLength={200} value={form.email} onChange={(e) => set("email", e.target.value)} className={inputCls} placeholder="name@domain.com" />
              </Field>
            </div>

            <div className="space-y-4 pt-2">
              <h3 className="text-sm font-semibold text-primary uppercase tracking-wider">📍 Logistics Destination</h3>
              <div className="grid gap-4 sm:grid-cols-2">
                <Field label="Hub Location *">
                  {locations ? (
                    <select required value={form.location_id} onChange={(e) => set("location_id", e.target.value)} className={inputCls}>
                      <option value="">Select a regional hub</option>
                      {locations.map((l: Location) => (
                        <option key={l.id} value={l.id}>
                          {l.area} — {l.name}
                        </option>
                      ))}
                    </select>
                  ) : (
                    <div className="h-10 rounded-md bg-secondary animate-pulse" />
                  )}
                </Field>
                <Field label="Assigned Area Zone">
                  <input readOnly value={form.area} className={`${inputCls} bg-secondary/50 cursor-not-allowed`} />
                </Field>
              </div>
              <Field label="Complete Delivery Street Address *">
                <textarea required rows={3} maxLength={500} value={form.delivery_address} onChange={(e) => set("delivery_address", e.target.value)} className={inputCls} placeholder="House, Road, Apartment Details..." />
              </Field>
            </div>

            <div className="space-y-4 pt-2">
              <h3 className="text-sm font-semibold text-primary uppercase tracking-wider">৳ Payment Verification</h3>
              <div className="grid gap-3 sm:grid-cols-3">
                {(["Cash On Delivery", "bKash", "Other"] as const).map((method) => (
                  <label key={method} className={`flex cursor-pointer flex-col justify-between rounded-xl border p-4 transition-all hover:bg-secondary/40 ${form.payment_method === method ? "border-primary bg-primary/5 text-primary" : "border-border"}`}>
                    <span className="flex items-center gap-2 text-sm font-medium">
                      <input type="radio" name="payment_method" value={method} checked={form.payment_method === method} onChange={() => set("payment_method", method)} className="text-primary focus:ring-primary" />
                      {method === "Cash On Delivery" ? "COD" : method}
                    </span>
                  </label>
                ))}
              </div>
              {form.payment_method === "Other" && (
                <Field label="Transaction Notes">
                  <input maxLength={200} value={form.payment_note} onChange={(e) => set("payment_note", e.target.value)} className={inputCls} placeholder="Specify payment details..." />
                </Field>
              )}
            </div>

            <button type="submit" disabled={status.kind === "pending" || cart.length === 0} className="w-full mt-4 rounded-xl bg-primary h-12 text-base font-semibold text-primary-foreground transition-all hover:bg-primary-glow disabled:opacity-50 shadow-md">
              {status.kind === "pending" ? "Validating & Booking…" : `Confirm & Place Order (৳${cartTotal.toLocaleString()})`}
            </button>

            {status.kind === "error" && <p className="text-center text-sm font-medium text-destructive">⚠️ {status.msg}</p>}
          </form>

          {/* Right Hand: Cart Summary Breakdown Panels */}
          <div className="lg:col-span-5 space-y-4 sticky top-6">
            <div className="rounded-2xl border border-border bg-card p-6 shadow-[var(--shadow-soft)]">
              <h3 className="font-serif text-xl font-bold border-b border-border pb-3">Basket Review</h3>
              <div className="mt-4 max-h-[320px] overflow-y-auto divide-y divide-border pr-1">
                {cart.map((item) => (
                  <div key={item.product.id} className="flex items-center justify-between py-3 gap-3">
                    <div>
                      <div className="font-medium text-sm text-foreground">{item.product.product_name}</div>
                      <div className="text-xs text-muted-foreground">
                        ৳{Number(item.product.price).toLocaleString()} × {item.quantity}
                      </div>
                    </div>
                    <div className="font-semibold text-sm whitespace-nowrap">
                      ৳{(Number(item.product.price) * item.quantity).toLocaleString()}
                    </div>
                  </div>
                ))}
              </div>

              <div className="mt-4 pt-4 border-t border-border space-y-2">
                <div className="flex justify-between text-sm text-muted-foreground">
                  <span>Shipping Handling</span>
                  <span className="font-medium text-emerald-600">FREE</span>
                </div>
                <div className="flex justify-between text-lg font-bold text-foreground pt-1">
                  <span>Total Due</span>
                  <span className="text-primary">৳{cartTotal.toLocaleString()}</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      )}
    </Section>
  );
}

const inputCls =
  "flex w-full rounded-md border border-input bg-background px-3 py-2 text-sm shadow-sm placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring min-h-[40px]";

function Field({ label, children }: { label: string; children: React.ReactNode }) {
  return (
    <label className="block space-y-1.5">
      <span className="text-xs font-semibold text-muted-foreground uppercase tracking-wider">{label}</span>
      {children}
    </label>
  );
}
